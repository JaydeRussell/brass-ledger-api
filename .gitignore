# Build output
/bin/
/tmp/
brass-ledger-api

# Go workspace/test artifacts
*.test
*.out

# Local environment — never commit real secrets/connection strings
.env
.env.*
!.env.example

# Log files (see LOG_FILE in .env.example) — local runtime output, not
# something to commit.
/logs/

# Editor/OS cruft
.DS_Store
.idea/
.vscode/

# Wrangler/Cloudflare Container deploy tooling (see wrangler.jsonc,
# src/worker.ts) — Node deps and local Wrangler state, not the app.
node_modules/
.wrangler/
.dev.vars
.dev.vars.*

# Leftover from before this project settled on Go — safe to delete
# locally (see README); kept out of git either way.
.venv/
__pycache__/
