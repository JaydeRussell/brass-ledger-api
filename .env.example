# Copy this to .env for local development (go run ./cmd/server will load
# it automatically via godotenv). Never commit the real .env — it's
# already in .gitignore.

# Standard Postgres connection string — whatever your provider (Neon,
# Supabase, Railway, a local Postgres) hands you.
DATABASE_URL=postgres://user:password@localhost:5432/brass_ledger?sslmode=disable

# Optional — defaults to 8080 if unset.
PORT=8080

# Google sign-in (see the README's "Google sign-in setup" section for a
# step-by-step walkthrough of creating these in Google Cloud Console).
# Both optional — leave them blank and the server starts fine with
# Google sign-in disabled (everything else, e.g. the BCP proxy, still
# works). GOOGLE_REDIRECT_URL must exactly match a redirect URI
# registered on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Access control (migration 0007): every sign-in starts pending —
# nobody can actually use the app (beyond signing in) until an admin
# approves them. Comma-separated emails, case-insensitive, e.g.
# ADMIN_EMAILS=you@example.com,other@example.com — every sign-in
# matching one of these is auto-approved as an admin, every time they
# sign in, not just their first. Without this set, nobody can ever
# approve anybody (including yourself), so set at least your own email
# here before relying on this in a real deployment.
ADMIN_EMAILS=

# Where a sign-in (successful or not) sends the browser back to.
FRONTEND_BASE_URL=http://localhost:3000

# Set to "true" for any real (HTTPS) deployment. Leave "false" for local
# http://localhost development — a browser silently refuses to store a
# Secure cookie at all over plain HTTP, which would otherwise break
# sign-in locally without any obvious error.
COOKIE_SECURE=false

# Where this service's logs (every request, plus startup/auth/DB errors)
# are written, in addition to always being echoed to stdout too. Relative
# to wherever the process is started from. `make logs` / `make logs-tail`
# read this same path. Leave commented out (or LOG_FILE=logs/backend.log)
# for the default; set to LOG_FILE= (empty) for stdout-only logging.
LOG_FILE=logs/backend.log
