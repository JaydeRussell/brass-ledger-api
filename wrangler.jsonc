{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brass-ledger-api",
  "compatibility_date": "2026-09-08",
  "main": "src/worker.ts",

  // Non-secret config — same env vars internal/config reads locally
  // (see .env.example). DATABASE_URL, GOOGLE_CLIENT_ID and
  // GOOGLE_CLIENT_SECRET are set as Worker secrets instead
  // (`wrangler secret put <NAME>`), never here, since this file is
  // git-tracked.
  "vars": {
    "PORT": "8080",
    "GOOGLE_REDIRECT_URL": "https://api.brass-ledger.app/auth/google/callback",
    "FRONTEND_BASE_URL": "https://brass-ledger.app",
    "COOKIE_SECURE": "true",
    // Scopes the SESSION cookie to the registrable domain so the
    // frontend Worker on brass-ledger.app can read it during render,
    // rather than every gated page waiting on a client-side /api/me
    // before it can show anything. The short-lived OAuth state cookies
    // stay host-only regardless — see internal/api's setSessionCookie.
    //
    // The cost, deliberately taken: the session cookie now reaches
    // every subdomain of brass-ledger.app, present and future. Do not
    // point a subdomain at a third party (a status page, a docs host,
    // any CNAME to a SaaS) without moving this back first — their
    // servers would receive session cookies on every request.
    "SESSION_COOKIE_DOMAIN": "brass-ledger.app",
    // The new-signup admin alert's sender address (see internal/notify)
    // — not secret, but only does anything paired with the
    // RESEND_API_KEY Worker secret below, and only once this domain is
    // added and verified in Resend's own dashboard.
    "EMAIL_FROM_ADDRESS": "Brass Ledger <alerts@brass-ledger.app>"
  },

  "containers": [
    {
      "class_name": "BackendContainer",
      // Reuses the existing multi-stage Dockerfile as-is — Wrangler
      // builds and pushes this image itself on `wrangler deploy`.
      "image": "./Dockerfile",
      // One instance is plenty for this app's scale, and keeps it from
      // opening more concurrent connections against Neon's connection
      // limit than intended.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "BACKEND", "class_name": "BackendContainer" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BackendContainer"] }
  ],

  // Provisions DNS + TLS for this hostname automatically on first
  // deploy, since the zone is already on Cloudflare — no manual DNS
  // record needed.
  "routes": [
    { "pattern": "api.brass-ledger.app", "custom_domain": true }
  ]
}
